# Lifetime probe: one floating chest, sampled every 30 s, to find how long a harness piece lives on
# this tree and whether the loss is a fixed timer.
cleanup
hold on
spawn piece_chest_wood -6 34.2 0
wait 5
comp piece_chest_wood WearNTear
zdo piece_chest_wood husnisse_net
wait 25
zdo piece_chest_wood husnisse_net
wait 30
zdo piece_chest_wood husnisse_net
wait 30
zdo piece_chest_wood husnisse_net
wait 30
zdo piece_chest_wood husnisse_net
